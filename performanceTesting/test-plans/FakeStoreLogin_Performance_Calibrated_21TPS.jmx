          <stringProp name="filename">C:\Proyectos\Sofka Technical Assessment\performanceTesting\results\FakeStoreLogin_Calibration_21TPS.jtl</stringProp>
          <stringProp name="TestPlan.comments">Performance test results - FakeStore Login</stringProp>
        </ResultCollector>
        <hashTree />
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Control Throughput - 20 TPS">
          <doubleProp>
            <name>throughput</name>
            <value>1260.0</value>
            <savedValue>0.0</savedValue>
          </doubleProp>
          <intProp name="calcMode">4</intProp>
